-void Audio_PlaySfxGeneral(u16 sfxId, Vec3f* pos, u8 token, f32* freqScale, f32* vol, s8* reverbAdd) {
+// Number of sfx in each bank, and the bank each one is moved to (ocarina stays).
+static u16 sSfxBankCounts[7] = {
+    NA_SE_PL_END - (NA_SE_PL_BASE + 1), NA_SE_IT_END - (NA_SE_IT_BASE + 1), NA_SE_EV_END - (NA_SE_EV_BASE + 1),
+    NA_SE_EN_END - (NA_SE_EN_BASE + 1), NA_SE_SY_END - (NA_SE_SY_BASE + 1), NA_SE_OC_END - (NA_SE_OC_BASE + 1),
+    NA_SE_VO_END - (NA_SE_VO_BASE + 1),
+};
+static u8 sNextSfxBank[7] = {
+    BANK_ITEM, BANK_ENV, BANK_ENEMY, BANK_SYSTEM, BANK_VOICE, BANK_OCARINA, BANK_PLAYER,
+};
+
+u32 Audio_WrongSfxListId(u32 sfxId) {
+    u32 bankId;
+
+    if ((sfxId == NA_SE_NONE) || (SFX_BANK(sfxId) >= 7)) {
+        return sfxId;
+    }
+    bankId = sNextSfxBank[SFX_BANK(sfxId)];
+    return (bankId << 12) | (sfxId & 0xE00) | (SFX_INDEX(sfxId) % sSfxBankCounts[bankId]);
+}
+
+void Audio_PlaySfxGeneral(u16 origSfxId, Vec3f* pos, u8 token, f32* freqScale, f32* vol, s8* reverbAdd) {
+    u16 sfxId = Audio_WrongSfxListId(origSfxId);

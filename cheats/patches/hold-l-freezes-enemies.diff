+/**
+ * Removes the actor's colliders from the AC list. With onlyIfHit, does this only if one of them was hit, and
+ * returns whether one was. CollisionCheck_ClearContext keeps frozen enemies' AC colliders while L is held.
+ */
+s32 Actor_RemoveKeptACColliders(PlayState* play, Actor* actor, s32 onlyIfHit) {
+    CollisionCheckContext* colChkCtx = &play->colChkCtx;
+    s32 hit = false;
+    s32 count = 0;
+    s32 i;
+
+    for (i = 0; i < colChkCtx->colACCount; i++) {
+        if ((colChkCtx->colAC[i]->actor == actor) && (colChkCtx->colAC[i]->acFlags & AC_HIT)) {
+            hit = true;
+        }
+    }
+    if (onlyIfHit && !hit) {
+        return false;
+    }
+    for (i = 0; i < colChkCtx->colACCount; i++) {
+        if (colChkCtx->colAC[i]->actor != actor) {
+            colChkCtx->colAC[count++] = colChkCtx->colAC[i];
+        }
+    }
+    for (i = count; i < colChkCtx->colACCount; i++) {
+        colChkCtx->colAC[i] = NULL;
+    }
+    colChkCtx->colACCount = count;
+    return hit;
+}
